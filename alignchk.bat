@echo off
chcp 65001 >nul
powershell -NoProfile -Command "$fs=[System.IO.File]::Open('\\.\E:','Open','Read','ReadWrite'); $mb=16777216; $b1=New-Object byte[] $mb; $fs.Position=$mb; try { $n=$fs.Read($b1,0,$mb); Write-Output ('A aligned-buffer  : read=' + $n) } catch { Write-Output ('A aligned-buffer  : EXC ' + $_.Exception.Message) }; $b2=New-Object byte[] ($mb+16); $fs.Position=$mb; try { $n=$fs.Read($b2,16,$mb); Write-Output ('B buf+16          : read=' + $n) } catch { Write-Output ('B buf+16          : EXC ' + $_.Exception.Message) }; $b3=New-Object byte[] ($mb+4096); $fs.Position=$mb; try { $n=$fs.Read($b3,4096,$mb); Write-Output ('C buf+4096        : read=' + $n) } catch { Write-Output ('C buf+4096        : EXC ' + $_.Exception.Message) }; $fs.Dispose()" > D:\dg_recover\alignchk.txt 2>&1
